# Vertex AI credentials -- copy to .env and fill in.
GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=us-central1

# Optional tuning (defaults shown)
# GEMINI_TIMEOUT_SECONDS=300       # per-request timeout
# GEMINI_RETRY_BASE_SECONDS=4      # first retry delay, doubled per attempt
# CHUNK_WORKERS=4                  # parallel ffmpeg cuts per lecture
